<template>
  <stack class="alpine-face">
    <image class="alpine-background" src="/common/watchfaces/alpine_night.jpg"></image>
    <div class="alpine-veil"></div>
    <div class="alpine-date-glass" @click="openToday"></div>
    <div class="alpine-date-row" @click="openToday"><div class="alpine-date-copy"><text class="alpine-week">{{ displayWeek }}</text><text class="alpine-date">{{ displayMonth }} {{ displayDate }}</text></div><text class="alpine-brand">VELA / ALPINE</text></div>
    <text class="alpine-eyebrow">MIDNIGHT TRAIL</text><text class="alpine-hour">{{ displayHours }}</text><div class="alpine-time-accent"></div><text class="alpine-minute">{{ displayMinutes }}</text>
    <div class="alpine-data-glass" style="top: {{ panelGlassTop }};"></div>
    <div class="alpine-data-row" style="top: {{ panelRowTop }};"><div class="alpine-metric" @click="openSteps"><text class="alpine-metric-label">STEPS</text><text class="alpine-step-value">{{ stepsText }}</text></div><div class="alpine-metric" @click="openHealth"><text class="alpine-metric-label">HEART</text><text class="alpine-heart-value">{{ currentHeartRate }}</text></div></div>
    <div class="alpine-battery-row" style="top: {{ batteryRowTop }};"><text class="alpine-battery-label">POWER</text><div class="alpine-battery-track"><div class="alpine-battery-fill" style="width: {{ batteryWidth }}; background-color: {{ batteryColor }};"></div></div><text class="alpine-battery-value">{{ batteryPercent }}%</text></div>
  </stack>
</template>

<script>
export default {
  props: ['displayWeek','displayMonth','displayDate','displayHours','displayMinutes','stepsText','currentHeartRate','batteryPercent','batteryWidth','batteryColor','panelGlassTop','panelRowTop','batteryRowTop'],
  openToday() { this.$emit('openToday') },
  openHealth() { this.$emit('openHealth') },
  openSteps() { this.$emit('openSteps') }
}
</script>

