{
  "package": "com.application.pomodoro",
  "name": "Pomodoro",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minAPILevel": 2,
  "minPlatformVersion": 1000,
  "icon": "/common/pomodoro-icon.png",
  "deviceTypeList": ["watch"],
  "features": [
    { "name": "system.router" },
    { "name": "system.device" },
    { "name": "system.storage" },
    { "name": "system.vibrator" }
  ],
  "config": { "logLevel": "log", "designWidth": 192 },
  "display": {
    "fullScreen": true,
    "titleBar": false,
    "backgroundColor": "#000000",
    "statusBarImmersive": true,
    "statusBarTextStyle": "light"
  },
  "router": {
    "entry": "pages/focus",
    "pages": {
      "pages/focus": { "component": "focus" },
      "pages/settings": { "component": "settings" },
      "pages/stats": { "component": "stats" }
    }
  }
}
