<template>
  <div class="circle-sport-face">
    <stack class="activity-ring">
      <progress class="activity-arc" type="arc" percent="{{ goalPercent }}" style="color: {{ faceAccent }};"></progress>
      <div class="circle-time-block">
        <div class="vital-time">
          <text class="vital-minute" style="color: {{ faceAccent }}">{{ displayMinutes }}</text>
          <text class="vital-hour">{{ displayHours }}</text>
        </div>
        <text class="circle-date" style="color: {{ faceAccent }}">{{ displayMonth }} {{ displayDate }}</text>
        <text class="circle-goal">目标 {{ goalPercent }}%</text>
      </div>
    </stack>
    <div class="circle-metric-row">
      <div class="circle-metric" @click="goToSteps">
        <image class="circle-metric-icon" src="/common/shoes.png"></image>
        <text class="circle-metric-value step-color">{{ stepsText }}</text>
      </div>
      <div class="circle-metric" @click="goToHeartRate">
        <image class="circle-metric-icon" src="/common/heart.png"></image>
        <text class="circle-metric-value heart-color">{{ currentHeartRate }}</text>
      </div>
      <div class="circle-metric">
        <image class="circle-metric-icon" src="/common/lightning.png"></image>
        <text class="circle-metric-value" style="color: {{ batteryColor }}">{{ batteryPercent }}%</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'

export default {
  props: [
    'displayMonth',
    'displayDate',
    'displayHours',
    'displayMinutes',
    'faceAccent',
    'goalPercent',
    'currentHeartRate',
    'stepsText',
    'batteryPercent',
    'batteryColor'
  ],

  goToHeartRate() {
    router.push({ uri: '/pages/heartrate', params: {} })
  },

  goToSteps() {
    router.push({ uri: '/pages/steps', params: {} })
  }
}
</script>

