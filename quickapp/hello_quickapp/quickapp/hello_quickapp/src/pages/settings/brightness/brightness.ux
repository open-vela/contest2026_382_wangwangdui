<template>
  <scroll class="brightness-page {{ viewportClass }}" scroll-y="true" style="position: {{ viewportPosition }}; left: {{ viewportLeft }}; top: {{ viewportTop }}; width: {{ viewportWidth }}; height: {{ viewportHeight }}; opacity: {{ pageOpacity }}; margin-left: {{ pageOffset }}px;" @touchstart="onTouchStart" @touchend="onTouchEnd">
    <text class="page-title" static>亮度</text>

    <div class="status-card">
      <text class="status-label" static>当前亮度</text>
      <text class="status-value">{{ brightnessText }}</text>
      <text class="status-sub">{{ brightnessValue }} / 255</text>
    </div>

    <div class="slider-card">
      <div class="slider-label-row">
        <text class="slider-label" static>手动亮度</text>
        <text class="slider-state">{{ manualStateText }}</text>
      </div>
      <slider class="brightness-slider"
        min="0"
        max="255"
        step="1"
        value="{{ brightnessValue }}"
        @change="onBrightnessChange">
      </slider>
      <div class="slider-scale">
        <text class="scale-text" static>暗</text>
        <text class="scale-text center" static>中</text>
        <text class="scale-text right" static>亮</text>
      </div>
    </div>

    <div class="setting-card" @click="toggleAutoBrightness">
      <div class="setting-copy">
        <text class="setting-title" static>自动亮度</text>
        <text class="setting-sub" static>根据场景模拟调节</text>
      </div>
      <text class="switch-text" style="color: {{ autoColor }}">{{ autoText }}</text>
    </div>

    <div class="setting-card" @click="toggleRaiseWake">
      <div class="setting-copy">
        <text class="setting-title" static>抬腕亮屏</text>
        <text class="setting-sub" static>息屏后可模拟唤醒</text>
      </div>
      <text class="switch-text" style="color: {{ raiseColor }}">{{ raiseText }}</text>
    </div>

    <div class="setting-card" @click="toggleLowPower">
      <div class="setting-copy">
        <text class="setting-title" static>低功耗模式</text>
        <text class="setting-sub" static>暗屏/息屏/降刷新率</text>
      </div>
      <text class="switch-text" style="color: {{ lowPowerColor }}">{{ lowPowerText }}</text>
    </div>
  </scroll>
</template>

<script>
import router from '@system.router'
import brightness from '@system.brightness'
import deviceSettings from '../../../common/device_settings'
import pageMotion from '../../../common/page_motion'
import swipeBack from '../../../common/swipe_back'
import pageViewport from '../../../common/page_viewport'

export default {
  private: {
    brightnessValue: 140,
    brightnessText: '55%',
    manualEnabled: true,
    manualStateText: '可调节',
    autoText: '关',
    autoColor: '#8E8E93',
    raiseText: '开',
    raiseColor: '#30D158',
    lowPowerText: '开',
    lowPowerColor: '#30D158',
    autoBrightness: false,
    raiseWakeEnabled: true,
    lowPowerEnabled: true,
    pageOpacity: 1,
    pageOffset: 0,
    viewportClass: '',
    viewportPosition: 'relative',
    viewportLeft: '0px',
    viewportWidth: '100%',
    viewportHeight: '100%',
    viewportTop: '0px'
  },

  onInit() {
    pageViewport.bind(this)
    this.loadSettings()
  },

  onShow() {
    pageMotion.enter(this)
    this.loadSettings()
  },

  onHide() {
    pageMotion.clear(this)
  },

  onDestroy() {
    pageMotion.clear(this)
  },

  loadSettings() {
    var self = this
    deviceSettings.load(function (settings) {
      self.brightnessValue = deviceSettings.getBrightnessValue(settings.brightnessValue)
      self.autoBrightness = settings.autoBrightness
      self.raiseWakeEnabled = settings.raiseWakeEnabled
      self.lowPowerEnabled = settings.lowPowerEnabled
      self.refreshView()
    })
  },

  refreshView() {
    this.brightnessText = Math.round((this.brightnessValue / 255) * 100) + '%'
    this.manualEnabled = !this.autoBrightness
    this.manualStateText = this.autoBrightness ? '自动管理' : '可调节'
    this.autoText = this.autoBrightness ? '开' : '关'
    this.autoColor = this.autoBrightness ? '#30D158' : '#8E8E93'
    this.raiseText = this.raiseWakeEnabled ? '开' : '关'
    this.raiseColor = this.raiseWakeEnabled ? '#30D158' : '#8E8E93'
    this.lowPowerText = this.lowPowerEnabled ? '开' : '关'
    this.lowPowerColor = this.lowPowerEnabled ? '#30D158' : '#8E8E93'
  },

  applyBrightness(value) {
    try {
      if (brightness && brightness.setValue) {
        brightness.setValue({
          value: value,
          fail: function () {
            console.log('brightness setting uses UI simulation')
          }
        })
      }
    } catch (e) {
      console.log('brightness API unavailable, keep UI setting')
    }
  },

  onBrightnessChange(e) {
    if (this.autoBrightness) {
      return
    }
    // Different simulator versions may expose progress directly or under detail.
    var value = this.brightnessValue
    if (e && e.progress !== undefined) {
      value = Number(e.progress)
    } else if (e && e.value !== undefined) {
      value = Number(e.value)
    } else if (e && e.detail && e.detail.progress !== undefined) {
      value = Number(e.detail.progress)
    } else if (e && e.detail && e.detail.value !== undefined) {
      value = Number(e.detail.value)
    }
    this.setBrightness(value)
  },

  setBrightness(value) {
    var self = this
    this.brightnessValue = deviceSettings.getBrightnessValue(value)
    this.refreshView()
    this.applyBrightness(this.brightnessValue)
    deviceSettings.update('brightnessValue', this.brightnessValue, function () {
      self.refreshView()
    })
  },

  toggleAutoBrightness() {
    this.autoBrightness = !this.autoBrightness
    this.refreshView()
    deviceSettings.update('autoBrightness', this.autoBrightness)
    try {
      if (brightness && brightness.setMode) {
        brightness.setMode({
          mode: this.autoBrightness ? 1 : 0,
          fail: function () {
            console.log('brightness mode uses UI simulation')
          }
        })
      }
    } catch (e) {
      console.log('brightness setMode unavailable, keep UI setting')
    }
    if (!this.autoBrightness) {
      this.applyBrightness(this.brightnessValue)
    }
  },

  toggleRaiseWake() {
    this.raiseWakeEnabled = !this.raiseWakeEnabled
    this.refreshView()
    deviceSettings.update('raiseWakeEnabled', this.raiseWakeEnabled)
  },

  toggleLowPower() {
    this.lowPowerEnabled = !this.lowPowerEnabled
    this.refreshView()
    deviceSettings.update('lowPowerEnabled', this.lowPowerEnabled)
  },

  onTouchStart(e) {
    swipeBack.start(this, e)
  },

  onTouchEnd(e) {
    swipeBack.end(this, e, router)
  }
}
</script>

<style>
.brightness-page {
  flex-direction: column;
  align-items: center;
  background-color: #000000;
  width: 100%;
  height: 100%;
  padding: 16px;
}

.page-title {
  font-size: 24px;
  font-weight: bold;
  color: #FFD60A;
  text-align: center;
  margin-top: 8px;
  margin-bottom: 12px;
}

.status-card {
  flex-direction: column;
  width: 160px;
  height: 84px;
  background-color: #14181F;
  border-radius: 8px;
  padding: 12px;
}

.status-label {
  font-size: 12px;
  color: #8E8E93;
}

.status-value {
  font-size: 28px;
  color: #FFD60A;
  font-weight: bold;
  margin-top: 4px;
}

.status-sub {
  font-size: 10px;
  color: #8E8E93;
  margin-top: 3px;
}

.slider-card {
  flex-direction: column;
  width: 160px;
  height: 76px;
  margin-top: 10px;
  padding: 9px;
  background-color: #111317;
  border-radius: 8px;
}

.slider-label-row {
  flex-direction: row;
  justify-content: space-between;
  width: 142px;
}

.slider-label {
  font-size: 12px;
  color: #FFFFFF;
  font-weight: bold;
}

.slider-state {
  font-size: 10px;
  color: #8E8E93;
}

.brightness-slider {
  width: 142px;
  height: 22px;
  color: #FFD60A;
  selected-color: #FFD60A;
  block-color: #FFFFFF;
}

.slider-scale {
  flex-direction: row;
  justify-content: space-between;
  width: 142px;
}

.scale-text {
  width: 34px;
  font-size: 9px;
  color: #666666;
}

.center {
  text-align: center;
}

.right {
  text-align: right;
}

.setting-card {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  width: 160px;
  height: 58px;
  background-color: #111317;
  border-radius: 8px;
  padding-left: 10px;
  padding-right: 10px;
  margin-top: 10px;
}

.setting-copy {
  flex-direction: column;
  width: 112px;
}

.setting-title {
  font-size: 15px;
  color: #FFFFFF;
  font-weight: bold;
}

.setting-sub {
  font-size: 10px;
  color: #8E8E93;
  margin-top: 4px;
}

.switch-text {
  width: 28px;
  font-size: 15px;
  font-weight: bold;
  text-align: right;
}

@media (shape: circle) {
  .brightness-page {
    padding-top: 16px;
    padding-left: 22px;
    padding-right: 22px;
    padding-bottom: 28px;
  }

  .page-title {
    font-size: 14px;
    margin-top: 0px;
    margin-bottom: 7px;
  }

  .status-card,
  .slider-card,
  .setting-card {
    width: 148px;
    border-radius: 17px;
  }

  .status-card {
    height: 65px;
    padding: 9px;
  }

  .status-label,
  .status-sub,
  .slider-state,
  .setting-sub {
    font-size: 7px;
  }

  .status-value {
    font-size: 19px;
  }

  .slider-card {
    height: 67px;
    margin-top: 7px;
  }

  .slider-label-row,
  .brightness-slider,
  .slider-scale {
    width: 130px;
  }

  .slider-label {
    font-size: 9px;
  }

  .scale-text {
    font-size: 6px;
  }

  .setting-card {
    height: 48px;
    margin-top: 7px;
  }

  .setting-copy {
    width: 103px;
  }

  .setting-title,
  .switch-text {
    font-size: 10px;
  }
}
</style>
