<template>
  <div class="select-page {{ isRect ? 'rect-select-page' : '' }} {{ viewportClass }}" style="position: {{ viewportPosition }}; left: {{ viewportLeft }}; top: {{ viewportTop }}; width: {{ viewportWidth }}; height: {{ viewportHeight }}; opacity: {{ pageOpacity }}; margin-left: {{ pageOffset }}px;" @touchstart="onTouchStart" @touchend="onTouchEnd">
    <div class="top-row" if="{{ profileReady && isPill }}">
      <text class="page-title">选择表盘</text>
      <text class="back-text" @click="goBack">返回</text>
    </div>

    <div class="face-card" if="{{ profileReady && isPill && pillPageIndex === 0 }}" style="border-color: {{ sportBorder }}" @click="selectSport">
      <div class="preview-panel sport-preview">
        <text class="preview-date">06/01</text>
        <text class="preview-big sport-time">08</text>
        <text class="preview-small">4,567 步</text>
      </div>
      <div class="face-copy">
        <div class="face-name-row">
          <text class="face-name">活力数字</text>
          <text class="face-badge" if="{{ sportSelected }}">已选</text>
        </div>
        <text class="face-desc">时间、心率、步数集中展示</text>
        <text class="face-tag">运动日常</text>
      </div>
    </div>

    <div class="face-card" if="{{ profileReady && isPill && pillPageIndex === 0 }}" style="border-color: {{ simpleBorder }}" @click="selectSimple">
      <div class="preview-panel simple-preview">
        <text class="simple-preview-time">08:32</text>
        <stack class="mini-ring">
          <progress class="mini-arc" type="arc" percent="68"></progress>
          <div class="mini-ring-center">
            <text class="mini-ring-text">68%</text>
          </div>
        </stack>
      </div>
      <div class="face-copy">
        <div class="face-name-row">
          <text class="face-name">极简霓虹</text>
          <text class="face-badge cyan-badge" if="{{ simpleSelected }}">已选</text>
        </div>
        <text class="face-desc">大时间和目标完成度</text>
        <text class="face-tag">简洁耐看</text>
      </div>
    </div>

    <div class="face-card" if="{{ profileReady && isPill && pillPageIndex === 1 }}" style="border-color: {{ dashboardBorder }}" @click="selectDashboard">
      <div class="preview-panel dash-preview">
        <text class="dash-preview-time">08:32</text>
        <div class="mini-bars">
          <div class="mini-bar bar-one"></div>
          <div class="mini-bar bar-two"></div>
          <div class="mini-bar bar-three"></div>
        </div>
        <text class="preview-small">心率 88</text>
      </div>
      <div class="face-copy">
        <div class="face-name-row">
          <text class="face-name">运动仪表</text>
          <text class="face-badge green-badge" if="{{ dashboardSelected }}">已选</text>
        </div>
        <text class="face-desc">进度条和心率趋势图</text>
        <text class="face-tag">数据控</text>
      </div>
    </div>

    <div class="face-card" if="{{ profileReady && isPill && pillPageIndex === 1 }}" style="border-color: {{ alpineBorder }}" @click="selectAlpine">
      <stack class="preview-panel alpine-preview">
        <image class="alpine-preview-background" src="/common/watchfaces/alpine_night.jpg"></image>
        <div class="alpine-preview-veil"></div>
        <text class="alpine-preview-hour">08</text>
        <text class="alpine-preview-minute">32</text>
        <text class="alpine-preview-label">ALPINE</text>
      </stack>
      <div class="face-copy">
        <div class="face-name-row">
          <text class="face-name">星野远山</text>
          <text class="face-badge orange-badge" if="{{ alpineSelected }}">已选</text>
        </div>
        <text class="face-desc">星空雪山和透明数据层</text>
        <text class="face-tag">沉浸夜景</text>
      </div>
    </div>

    <div class="pill-face-pager" if="{{ profileReady && isPill }}">
      <text class="pill-page-button" @click="previousPillPage">‹</text>
      <text class="pill-page-number">{{ pillPageText }}</text>
      <text class="pill-page-button" @click="nextPillPage">›</text>
    </div>
    <text class="page-hint" if="{{ profileReady && isPill }}">左右翻页，点击表盘立即应用</text>

    <div class="circle-select-header" if="{{ profileReady && !isPill }}">
      <text class="circle-select-title">表盘库</text>
      <text class="circle-back" @click="goBack">返回</text>
    </div>
    <swiper class="circle-face-swiper" if="{{ profileReady && !isPill }}" index="{{ circlePreviewIndex }}" indicator="true" @change="onCircleFaceChange">
      <div class="circle-preview-slide" @click="selectSport">
        <stack class="circle-preview sport-preview-circle">
          <progress class="circle-preview-arc sport-circle-arc" type="arc" percent="72"></progress>
          <div class="circle-preview-center">
            <div class="circle-preview-vital">
              <text class="circle-preview-minute">32</text>
              <text class="circle-preview-hour">08</text>
            </div>
            <text class="circle-preview-sub">4,567 步</text>
          </div>
        </stack>
      </div>
      <div class="circle-preview-slide" @click="selectSimple">
        <stack class="circle-preview simple-preview-circle">
          <progress class="circle-preview-arc simple-circle-arc" type="arc" percent="68"></progress>
          <div class="circle-preview-center">
            <text class="circle-preview-time">08:32</text>
            <text class="circle-preview-sub">目标 68%</text>
          </div>
        </stack>
      </div>
      <div class="circle-preview-slide" @click="selectDashboard">
        <div class="circle-preview dash-preview-circle">
          <text class="circle-preview-time">08:32</text>
          <div class="circle-preview-metrics">
            <text class="circle-preview-chip">步数</text>
            <text class="circle-preview-chip">心率</text>
          </div>
          <text class="circle-preview-sub">运动仪表</text>
        </div>
      </div>
      <div class="circle-preview-slide" if="{{ isCircle }}" @click="selectMechanical">
        <stack class="circle-preview mechanical-preview-circle">
          <div class="mechanical-preview-ring"></div>
          <text class="mechanical-preview-twelve">XII</text>
          <text class="mechanical-preview-six">VI</text>
          <text class="mechanical-preview-brand">VELA</text>
          <div class="mechanical-preview-hour"></div>
          <div class="mechanical-preview-minute"></div>
          <div class="mechanical-preview-second"></div>
          <div class="mechanical-preview-pin"></div>
        </stack>
      </div>
    </swiper>
    <text class="circle-preview-name" if="{{ profileReady && !isPill }}">{{ circlePreviewName }} · 点击应用</text>
  </div>
</template>

<script>
import router from '@system.router'
import watchData from '../../common/watch_data'
import pageMotion from '../../common/page_motion'
import faceRegistry from '../../common/face_registry'
import pageViewport from '../../common/page_viewport'

export default {
  private: {
    sportBorder: '#0A84FF',
    simpleBorder: '#2C2C2E',
    dashboardBorder: '#2C2C2E',
    alpineBorder: '#2C2C2E',
    sportSelected: true,
    simpleSelected: false,
    dashboardSelected: false,
    mechanicalSelected: false,
    alpineSelected: false,
    isCircle: false,
    isPill: false,
    isRect: false,
    profileReady: false,
    viewportClass: '',
    viewportPosition: 'relative',
    viewportLeft: '0px',
    viewportWidth: '100%',
    viewportHeight: '100%',
    viewportTop: '0px',
    circlePreviewIndex: 0,
    circlePreviewName: '活力数字',
    loadedFaceId: 'sport',
    faceScope: 'rect',
    pillPageIndex: 0,
    pillPageText: '1 / 2',
    pageOpacity: 1,
    pageOffset: 0
  },

  onInit() {
    var self = this
    pageViewport.bind(this, function (profile) {
      self.isCircle = profile.isCircle
      self.isPill = profile.isPill
      self.isRect = profile.isRect
      self.faceScope = profile.formFactor
      self.profileReady = true
      self.updateSelectedState(self.loadedFaceId)
    })
  },

  onShow() {
    pageMotion.enter(this)
    this.loadSelectedState()
  },

  onHide() {
    pageMotion.clear(this)
  },

  onDestroy() {
    pageMotion.clear(this)
  },

  loadSelectedState() {
    watchData.loadSelectedFaceId((selected) => {
      this.loadedFaceId = selected
      this.updateSelectedState(selected)
    })
  },

  // Highlighting is local UI state; the selected id itself lives in the data adapter.
  updateSelectedState(selected) {
    var normalized = faceRegistry.getById(selected, this.faceScope).id
    this.sportSelected = normalized === 'sport'
    this.simpleSelected = normalized === 'simple'
    this.dashboardSelected = normalized === 'dashboard'
    this.mechanicalSelected = normalized === 'mechanical'
    this.alpineSelected = normalized === 'alpine'
    this.sportBorder = this.sportSelected ? '#0A84FF' : '#2C2C2E'
    this.simpleBorder = this.simpleSelected ? '#00E5FF' : '#2C2C2E'
    this.dashboardBorder = this.dashboardSelected ? '#32D74B' : '#2C2C2E'
    this.alpineBorder = this.alpineSelected ? '#FF9F4A' : '#2C2C2E'
    this.circlePreviewIndex = faceRegistry.getIndex(normalized, this.faceScope)
    this.circlePreviewName = faceRegistry.getByIndex(this.circlePreviewIndex, this.faceScope).name
    if (this.isPill) {
      this.pillPageIndex = normalized === 'dashboard' || normalized === 'alpine' ? 1 : 0
      this.refreshPillPageText()
    }
  },

  onCircleFaceChange(event) {
    var index = event && (event.index !== undefined ? event.index : event.detail && event.detail.index)
    if (index === undefined || index === null) return
    this.circlePreviewIndex = index
    this.circlePreviewName = faceRegistry.getByIndex(index, this.faceScope).name
  },

  selectSport() {
    this.selectFace('sport')
  },

  selectSimple() {
    this.selectFace('simple')
  },

  selectDashboard() {
    this.selectFace('dashboard')
  },

  selectMechanical() {
    if (this.isCircle) this.selectFace('mechanical')
  },

  selectAlpine() {
    if (this.isPill) this.selectFace('alpine')
  },

  refreshPillPageText() {
    this.pillPageText = this.pillPageIndex + 1 + ' / 2'
  },

  previousPillPage() {
    if (this.pillPageIndex > 0) this.pillPageIndex--
    this.refreshPillPageText()
  },

  nextPillPage() {
    if (this.pillPageIndex < 1) this.pillPageIndex++
    this.refreshPillPageText()
  },

  // The common adapter keeps this page independent from clock.ux internals.
  selectFace(id) {
    if (this.savingFace) {
      return
    }
    this.savingFace = true
    this.updateSelectedState(id)
    var self = this
    watchData.setSelectedFaceId(id, function () {
      self.savingFace = false
      pageMotion.back(self, router)
    })
  },

  goBack() {
    pageMotion.back(this, router)
  },

  onTouchStart(e) {
    if (e.touches && e.touches[0]) {
      this.touchStartX = e.touches[0].pageX
    }
  },

  onTouchEnd(e) {
    if (!e.changedTouches || !e.changedTouches[0]) {
      return
    }
    var touchEndX = e.changedTouches[0].pageX
    var diffX = touchEndX - this.touchStartX

    if (diffX < -30 && this.isPill) this.nextPillPage()
    else if (diffX > 30 && this.isPill && this.pillPageIndex > 0) this.previousPillPage()
    else if (diffX > 30) pageMotion.back(this, router)
  }
}
</script>

