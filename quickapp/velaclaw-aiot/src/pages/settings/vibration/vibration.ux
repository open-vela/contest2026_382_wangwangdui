<template>
  <stack class="detail-root {{ viewportClass }}" style="position: {{ viewportPosition }}; left: {{ viewportLeft }}; top: {{ viewportTop }}; width: {{ viewportWidth }}; height: {{ viewportHeight }};">
    <div class="detail-scene" style="width: {{ sceneWidth }}px; height: {{ sceneHeight }}px;">
      <div class="header" style="left: {{ headerLeft }}px; top: {{ headerTop }}px; width: {{ headerWidth }}px; height: {{ headerHeight }}px;"><text class="title" style="font-size: {{ titleSize }}px;">震动反馈</text><text class="page-text">{{ pageIndex + 1 }} / 2</text></div>
      <scroll class="content" scroll-y="true" style="left: {{ streamLeft }}px; top: {{ streamTop }}px; width: {{ streamWidth }}px; height: {{ streamHeight }}px;">
        <div if="{{ pageIndex === 0 }}" class="panel" style="width: {{ streamWidth }}px;">
          <div class="status-card" @click="toggleVibration" style="width: {{ streamWidth }}px; height: {{ statusCardHeight }}px; border-radius: {{ cardRadius }}px; border-color: {{ statusColor }};"><div class="copy"><text class="label" style="font-size: {{ bodySize }}px;">通知与交互反馈</text><text class="status-value" style="font-size: {{ valueSize }}px; color: {{ statusColor }};">{{ statusText }}</text><text class="sub" style="font-size: {{ bodySize }}px;">强度 {{ levelText }} · {{ patternText }}</text></div><text class="switch" style="color: {{ statusColor }};">{{ enabledText }}</text></div>
          <text class="section-label" style="width: {{ streamWidth }}px; font-size: {{ bodySize }}px;">基础强度</text>
          <div class="level-row" style="width: {{ streamWidth }}px; height: {{ levelRowHeight }}px;"><text class="level-button" style="width: {{ levelButtonWidth }}px; height: {{ levelButtonHeight }}px; background-color: {{ lightBg }};" @click="setLight">轻</text><text class="level-button" style="width: {{ levelButtonWidth }}px; height: {{ levelButtonHeight }}px; background-color: {{ mediumBg }};" @click="setMedium">中</text><text class="level-button" style="width: {{ levelButtonWidth }}px; height: {{ levelButtonHeight }}px; background-color: {{ strongBg }};" @click="setStrong">强</text></div>
          <div class="test-card" @click="playCurrent" style="width: {{ streamWidth }}px; height: {{ testCardHeight }}px; border-radius: {{ cardRadius }}px; margin-top: {{ cardGap }}px;"><div class="test-copy"><text class="test-title" style="font-size: {{ testTitleSize }}px;">测试当前模式</text><text class="sub test-feedback" style="font-size: {{ bodySize }}px;">{{ feedbackText }}</text></div><text class="arrow">›</text></div>
        </div>
        <div if="{{ pageIndex === 1 }}" class="panel" style="width: {{ streamWidth }}px;">
          <div class="capability-card" style="width: {{ streamWidth }}px; height: {{ capabilityCardHeight }}px; border-radius: {{ cardRadius }}px;"><text class="label" style="font-size: {{ bodySize }}px;">反馈引擎</text><text class="capability" style="color: {{ capabilityColor }};">{{ capabilityText }}</text><text class="sub" style="font-size: {{ bodySize }}px;">系统模式 {{ systemModeText }}</text></div>
          <div class="pattern-card" style="width: {{ streamWidth }}px; height: {{ patternCardHeight }}px; background-color: {{ tapBg }}; border-radius: {{ cardRadius }}px;" @click="selectTap"><text class="pattern-name" style="font-size: {{ testTitleSize }}px;">轻触</text><text class="sub pattern-sub" style="font-size: {{ bodySize }}px;">单次短反馈</text><text class="state">{{ tapState }}</text></div>
          <div class="pattern-card" style="width: {{ streamWidth }}px; height: {{ patternCardHeight }}px; background-color: {{ goalBg }}; border-radius: {{ cardRadius }}px;" @click="selectGoal"><text class="pattern-name" style="font-size: {{ testTitleSize }}px;">达标</text><text class="sub pattern-sub" style="font-size: {{ bodySize }}px;">两次确认反馈</text><text class="state">{{ goalState }}</text></div>
          <div class="pattern-card" style="width: {{ streamWidth }}px; height: {{ patternCardHeight }}px; background-color: {{ countdownBg }}; border-radius: {{ cardRadius }}px;" @click="selectCountdown"><text class="pattern-name" style="font-size: {{ testTitleSize }}px;">倒计时</text><text class="sub pattern-sub" style="font-size: {{ bodySize }}px;">三次节奏反馈</text><text class="state">{{ countdownState }}</text></div>
          <div class="pattern-card" style="width: {{ streamWidth }}px; height: {{ patternCardHeight }}px; background-color: {{ alertBg }}; border-radius: {{ cardRadius }}px;" @click="selectAlert"><text class="pattern-name" style="font-size: {{ testTitleSize }}px;">警报</text><text class="sub pattern-sub" style="font-size: {{ bodySize }}px;">两次长震动</text><text class="state">{{ alertState }}</text></div>
        </div>
        <div class="pager" style="width: {{ streamWidth }}px; height: {{ pagerHeight }}px;"><text class="pager-button" @click="previousPage">‹</text><text class="pager-label">{{ pageLabel }}</text><text class="pager-button" @click="nextPage">›</text></div>
      </scroll>
    </div>
  </stack>
</template>

<script>
import pageRuntime from '../../../v2/app/page_runtime'
import navigation from '../../../v2/app/navigation'
import { createVibrationController } from '../../../v2/features/settings/vibration_controller'
import detailDesign from '../../../v2/design/specs/settings_detail'
import vibrationView from '../../../v2/design/views/settings_vibration'

export default {
  private: {
    pageIndex: 0, pageLabel: '开关与强度', statusText: '已开启', statusColor: '#30D158', enabledText: '开', levelText: '中', patternText: '达标', feedbackText: '点击播放反馈', capabilityText: '检测中', capabilityColor: '#8E8E93', systemModeText: '未知',
    lightBg: '#1C1C1E', mediumBg: '#FF9F0A', strongBg: '#1C1C1E', tapBg: '#14181F', goalBg: '#2D210F', countdownBg: '#14181F', alertBg: '#14181F', tapState: '›', goalState: '已选', countdownState: '›', alertState: '›',
    headerLeft: 22, headerTop: 24, headerWidth: 148, headerHeight: 20, streamLeft: 22, streamTop: 49, streamWidth: 148, streamHeight: 120, titleSize: 12, cardRadius: 16, cardGap: 6,
    statusCardHeight: 64, levelRowHeight: 34, levelButtonWidth: 45, levelButtonHeight: 34, testCardHeight: 56, capabilityCardHeight: 64, patternCardHeight: 50, pagerHeight: 30, bodySize: 7, valueSize: 18, testTitleSize: 10,
    sceneWidth: 192, sceneHeight: 192, viewportClass: '', viewportPosition: 'relative', viewportLeft: '0px', viewportTop: '0px', viewportWidth: '100%', viewportHeight: '100%'
  },
  onInit() {
    var self = this
    this.controller = createVibrationController(function (model) { self.applyView(vibrationView.project(model)) })
    pageRuntime.bind(this, { contentWidth: function (profile) { return detailDesign.contentWidth(profile) } }, function (profile, scene, safe) {
      var plan = detailDesign.resolve(profile, scene, safe)
      self.headerLeft = plan.header.left; self.headerTop = plan.header.top; self.headerWidth = plan.header.width; self.headerHeight = plan.header.height
      self.streamLeft = plan.stream.left; self.streamTop = plan.stream.top; self.streamWidth = plan.stream.width; self.streamHeight = plan.stream.height
      self.titleSize = plan.titleSize; self.cardRadius = plan.cardRadius; self.cardGap = plan.cardGap; self.bodySize = plan.bodySize; self.valueSize = plan.valueSize; self.testTitleSize = plan.testTitleSize
      self.statusCardHeight = plan.controls.statusCardHeight; self.levelRowHeight = plan.controls.levelRowHeight; self.levelButtonWidth = plan.controls.levelButtonWidth; self.levelButtonHeight = plan.controls.levelButtonHeight
      self.testCardHeight = plan.controls.testCardHeight; self.capabilityCardHeight = plan.controls.capabilityCardHeight; self.patternCardHeight = plan.controls.patternCardHeight; self.pagerHeight = plan.controls.pagerHeight
    })
  },
  onShow() { this.controller.load() },
  onHide() { this.controller.stop() },
  onDestroy() { this.controller.stop() },
  onBackPress() { navigation.back(); return true },
  applyView(view) {
    this.statusText = view.statusText; this.statusColor = view.statusColor; this.enabledText = view.enabledText; this.levelText = view.levelText; this.patternText = view.patternText; this.feedbackText = view.feedbackText; this.capabilityText = view.capabilityText; this.capabilityColor = view.capabilityColor; this.systemModeText = view.systemModeText
    this.lightBg = view.lightBg; this.mediumBg = view.mediumBg; this.strongBg = view.strongBg
    this.tapBg = view.tapBg; this.goalBg = view.goalBg; this.countdownBg = view.countdownBg; this.alertBg = view.alertBg
    this.tapState = view.tapState; this.goalState = view.goalState; this.countdownState = view.countdownState; this.alertState = view.alertState
  },
  toggleVibration() { this.controller.toggle() }, setLight() { this.controller.setLevel('light') }, setMedium() { this.controller.setLevel('medium') }, setStrong() { this.controller.setLevel('strong') }, playCurrent() { this.controller.playCurrent() },
  selectTap() { this.controller.selectPattern('tap') }, selectGoal() { this.controller.selectPattern('goal') }, selectCountdown() { this.controller.selectPattern('countdown') }, selectAlert() { this.controller.selectPattern('alert') },
  previousPage() { if (this.pageIndex > 0) this.pageIndex--; this.pageLabel = this.pageIndex === 0 ? '开关与强度' : '反馈模式' },
  nextPage() { if (this.pageIndex < 1) this.pageIndex++; this.pageLabel = this.pageIndex === 0 ? '开关与强度' : '反馈模式' }
}
</script>

<style>
.detail-root, .detail-scene { background-color: #000000; } .detail-scene { position: absolute; left: 0px; top: 0px; }
.header, .content { position: absolute; } .header { flex-direction: row; justify-content: space-between; align-items: center; }
.title { color: #FF9F0A; font-weight: bold; } .page-text { color: #8E8E93; font-size: 7px; }
.content, .panel { flex-direction: column; } .panel { align-items: center; }
.status-card, .test-card, .capability-card, .pattern-card { padding: 10px; background-color: #14181F; margin-bottom: 7px; }
.status-card { border-width: 1px; flex-direction: row; justify-content: space-between; align-items: center; } .copy { flex: 1; flex-direction: column; }
.label, .sub { color: #8E8E93; } .status-value { font-weight: bold; margin-top: 3px; } .switch { width: 28px; font-size: 13px; font-weight: bold; text-align: right; }
.section-label { color: #8E8E93; margin-top: 4px; margin-bottom: 5px; }
.level-row { flex-direction: row; justify-content: space-between; align-items: center; }
.level-button { border-radius: 12px; color: #FFFFFF; font-size: 11px; text-align: center; }
.test-card { flex-direction: row; align-items: center; justify-content: space-between; } .test-copy { flex: 1; flex-direction: column; } .test-title { color: #FFFFFF; font-weight: bold; } .test-feedback { margin-top: 4px; } .arrow { width: 18px; color: #636366; font-size: 14px; text-align: right; }
.capability-card { flex-direction: column; justify-content: center; } .capability { font-size: 14px; font-weight: bold; margin-top: 3px; margin-bottom: 3px; }
.pattern-card { flex-direction: row; align-items: center; } .pattern-name { width: 50px; color: #FFFFFF; font-weight: bold; } .pattern-sub { flex: 1; } .state { width: 32px; color: #FF9F0A; font-size: 7px; text-align: right; }
.pager { flex-direction: row; justify-content: space-between; align-items: center; margin-top: 4px; } .pager-button { width: 30px; font-size: 20px; color: #FF9F0A; text-align: center; } .pager-label { color: #8E8E93; font-size: 7px; text-align: center; }
</style>
