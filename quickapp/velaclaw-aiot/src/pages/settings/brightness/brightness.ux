<template>
  <stack class="detail-root {{ viewportClass }}" style="position: {{ viewportPosition }}; left: {{ viewportLeft }}; top: {{ viewportTop }}; width: {{ viewportWidth }}; height: {{ viewportHeight }};">
    <div class="detail-scene" style="width: {{ sceneWidth }}px; height: {{ sceneHeight }}px;">
      <div class="header" style="left: {{ headerLeft }}px; top: {{ headerTop }}px; width: {{ headerWidth }}px; height: {{ headerHeight }}px;"><text class="title" style="font-size: {{ titleSize }}px;">亮度与省电</text><text class="back" @click="goBack">返回</text></div>
      <scroll class="content" scroll-y="true" style="left: {{ streamLeft }}px; top: {{ streamTop }}px; width: {{ streamWidth }}px; height: {{ streamHeight }}px;">
        <div class="status-card" style="width: {{ streamWidth }}px; border-radius: {{ cardRadius }}px;"><text class="label">当前亮度</text><text class="brightness-value" style="font-size: {{ valueSize }}px;">{{ brightnessText }}</text><text class="sub">{{ brightnessDetail }}</text></div>
        <div class="slider-card" style="width: {{ streamWidth }}px; border-radius: {{ cardRadius }}px; margin-top: {{ cardGap }}px;"><div class="row"><text class="setting-title">手动亮度</text><text class="sub">{{ manualStateText }}</text></div><slider class="brightness-slider" min="0" max="255" step="1" value="{{ brightnessValue }}" @change="onBrightnessChange"></slider><div class="scale"><text class="scale-label">暗</text><text class="scale-label">中</text><text class="scale-label">亮</text></div></div>
        <div class="setting-card" @click="toggleAuto" style="width: {{ streamWidth }}px; border-radius: {{ cardRadius }}px; margin-top: {{ cardGap }}px;"><div class="copy"><text class="setting-title">自动亮度</text><text class="sub">根据场景模拟调节</text></div><text class="switch" style="color: {{ autoColor }};">{{ autoText }}</text></div>
        <div class="setting-card" @click="toggleRaiseWake" style="width: {{ streamWidth }}px; border-radius: {{ cardRadius }}px; margin-top: {{ cardGap }}px;"><div class="copy"><text class="setting-title">抬腕亮屏</text><text class="sub">息屏后动作唤醒</text></div><text class="switch" style="color: {{ raiseColor }};">{{ raiseText }}</text></div>
        <div class="setting-card" @click="toggleLowPower" style="width: {{ streamWidth }}px; border-radius: {{ cardRadius }}px; margin-top: {{ cardGap }}px;"><div class="copy"><text class="setting-title">低功耗模式</text><text class="sub">暗屏、息屏与降刷新率</text></div><text class="switch" style="color: {{ lowPowerColor }};">{{ lowPowerText }}</text></div>
      </scroll>
    </div>
  </stack>
</template>

<script>
import pageRuntime from '../../../v2/app/page_runtime'
import navigation from '../../../v2/app/navigation'
import { createBrightnessController } from '../../../v2/features/settings/brightness_controller'
import detailDesign from '../../../v2/design/specs/settings_detail'
import brightnessView from '../../../v2/design/views/settings_brightness'

export default {
  private: {
    brightnessValue: 140, brightnessText: '55%', brightnessDetail: '140 / 255', manualStateText: '可调节', autoText: '关', autoColor: '#8E8E93', raiseText: '开', raiseColor: '#30D158', lowPowerText: '开', lowPowerColor: '#30D158',
    headerLeft: 22, headerTop: 24, headerWidth: 148, headerHeight: 20, streamLeft: 22, streamTop: 49, streamWidth: 148, streamHeight: 120, titleSize: 12, cardRadius: 16, cardGap: 6, valueSize: 18,
    sceneWidth: 192, sceneHeight: 192, viewportClass: '', viewportPosition: 'relative', viewportLeft: '0px', viewportTop: '0px', viewportWidth: '100%', viewportHeight: '100%'
  },
  onInit() {
    var self = this
    this.controller = createBrightnessController(function (model) { self.applyView(brightnessView.project(model)) })
    pageRuntime.bind(this, { contentWidth: function (profile) { return detailDesign.contentWidth(profile) } }, function (profile, scene, safe) {
      var plan = detailDesign.resolve(profile, scene, safe)
      self.headerLeft = plan.header.left; self.headerTop = plan.header.top; self.headerWidth = plan.header.width; self.headerHeight = plan.header.height
      self.streamLeft = plan.stream.left; self.streamTop = plan.stream.top; self.streamWidth = plan.stream.width; self.streamHeight = plan.stream.height
      self.titleSize = plan.titleSize; self.cardRadius = plan.cardRadius; self.cardGap = plan.cardGap; self.valueSize = plan.valueSize
    })
  },
  onShow() { this.controller.load() },
  onBackPress() { navigation.back(); return true },
  applyView(view) { this.brightnessValue = view.brightnessValue; this.brightnessText = view.brightnessText; this.brightnessDetail = view.brightnessDetail; this.manualStateText = view.manualStateText; this.autoText = view.autoText; this.autoColor = view.autoColor; this.raiseText = view.raiseText; this.raiseColor = view.raiseColor; this.lowPowerText = view.lowPowerText; this.lowPowerColor = view.lowPowerColor },
  onBrightnessChange(event) { var value = this.brightnessValue; if (event && event.progress !== undefined) value = event.progress; else if (event && event.value !== undefined) value = event.value; else if (event && event.detail && event.detail.progress !== undefined) value = event.detail.progress; else if (event && event.detail && event.detail.value !== undefined) value = event.detail.value; this.controller.setBrightness(value) },
  toggleAuto() { this.controller.toggleAuto() },
  toggleRaiseWake() { this.controller.toggleRaiseWake() },
  toggleLowPower() { this.controller.toggleLowPower() },
  goBack() { navigation.back() }
}
</script>

<style>
.detail-root, .detail-scene { background-color: #000000; }
.detail-scene { position: absolute; left: 0px; top: 0px; }
.header, .content { position: absolute; }
.header, .row, .setting-card { flex-direction: row; justify-content: space-between; align-items: center; }
.title { color: #FFD60A; font-weight: bold; } .back { color: #8E8E93; font-size: 8px; }
.content { flex-direction: column; }
.status-card, .slider-card, .setting-card { background-color: #111317; padding: 12px; flex-direction: column; }
.status-card { min-height: 76px; } .label, .sub { color: #8E8E93; font-size: 8px; } .brightness-value { color: #FFD60A; font-weight: bold; margin-top: 3px; }
.slider-card { min-height: 78px; } .row { width: 100%; } .setting-title { color: #FFFFFF; font-size: 11px; font-weight: bold; } .brightness-slider { width: 100%; height: 24px; color: #FFD60A; selected-color: #FFD60A; block-color: #FFFFFF; }
.scale { width: 100%; flex-direction: row; justify-content: space-between; } .scale-label { color: #636366; font-size: 7px; }
.setting-card { min-height: 58px; flex-direction: row; } .copy { flex: 1; flex-direction: column; } .switch { width: 28px; font-size: 13px; font-weight: bold; text-align: right; }
</style>
