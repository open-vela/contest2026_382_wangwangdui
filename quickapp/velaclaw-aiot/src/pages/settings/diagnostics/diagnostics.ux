<template>
  <stack class="detail-root {{ viewportClass }}" style="position: {{ viewportPosition }}; left: {{ viewportLeft }}; top: {{ viewportTop }}; width: {{ viewportWidth }}; height: {{ viewportHeight }};">
    <div class="detail-scene" style="width: {{ sceneWidth }}px; height: {{ sceneHeight }}px;">
      <div class="header" style="left: {{ headerLeft }}px; top: {{ headerTop }}px; width: {{ headerWidth }}px; height: {{ headerHeight }}px;"><text class="title" style="font-size: {{ titleSize }}px;">设备自检</text><text class="page-text">{{ pageText }}</text></div>
      <div class="content" style="left: {{ streamLeft }}px; top: {{ streamTop }}px; width: {{ streamWidth }}px; height: {{ streamHeight }}px;">
        <div class="device-card" if="{{ pageIndex === 0 }}" style="width: {{ streamWidth }}px; border-radius: {{ cardRadius }}px;">
          <div class="device-head"><div class="device-dot"></div><text class="device-title">运行时设备档案</text></div>
          <div class="info-row"><text class="info-label">设备族</text><text class="info-value">{{ deviceFamily }}</text></div>
          <div class="info-row"><text class="info-label">物理屏</text><text class="info-value">{{ screenSize }}</text></div>
          <div class="info-row"><text class="info-label">Host Scene</text><text class="info-value">{{ hostSceneText }}</text></div>
          <div class="info-row"><text class="info-label">形态</text><text class="info-value">{{ formFactor }}</text></div>
          <div class="info-row"><text class="info-label">平台</text><text class="info-value">{{ platformText }}</text></div>
          <div class="info-row"><text class="info-label">视口策略</text><text class="info-value accent">{{ viewportMode }}</text></div>
          <text class="device-tip">V2 页面只消费 Host Scene 与我们自己的 Capability API；原生设备接口不会泄漏到页面。</text>
        </div>

        <div class="capability-list" if="{{ pageIndex > 0 }}">
          <div class="capability-card" for="{{ capabilityPage }}" tid="id" style="width: {{ streamWidth }}px; height: {{ capabilityHeight }}px; margin-bottom: {{ capabilityGap }}px; border-radius: {{ cardRadius }}px;">
            <div class="capability-copy"><text class="capability-name">{{ $item.name }}</text><text class="capability-api">{{ $item.api }}</text></div>
            <div class="status-pill" style="background-color: {{ $item.background }};"><text class="status-text" style="color: {{ $item.color }};">{{ $item.status }}</text></div>
          </div>
          <text class="capability-tip">这里验证的是应用自己的系统接口。传感器实时出数请进入“动作与加速度”。</text>
        </div>
      </div>
      <div class="pager" style="left: {{ streamLeft }}px; top: {{ pagerTop }}px; width: {{ streamWidth }}px; height: {{ pagerHeight }}px;"><text class="pager-button" @click="previousPage">‹</text><div class="pager-track"><div class="pager-fill" style="width: {{ pageProgress }};"></div></div><text class="pager-button" @click="nextPage">›</text></div>
    </div>
  </stack>
</template>

<script>
import pageRuntime from '../../../v2/app/page_runtime'
import navigation from '../../../v2/app/navigation'
import { createDiagnosticsController } from '../../../v2/features/settings/diagnostics_controller'
import detailDesign from '../../../v2/design/specs/settings_detail'
import diagnosticsView from '../../../v2/design/views/diagnostics'

export default {
  private: {
    pageIndex: 0, pageText: '1 / 1', pageProgress: '100%', capabilityPage: [], capabilities: [],
    deviceFamily: '检测中', screenSize: '--', hostSceneText: '--', formFactor: '--', platformText: '--', viewportMode: '--',
    headerLeft: 22, headerTop: 24, headerWidth: 148, headerHeight: 20, streamLeft: 22, streamTop: 49, streamWidth: 148, streamHeight: 104, pagerTop: 158, pagerHeight: 18,
    titleSize: 12, cardRadius: 16, capabilityHeight: 24, capabilityGap: 5,
    sceneWidth: 192, sceneHeight: 192, viewportClass: '', viewportPosition: 'relative', viewportLeft: '0px', viewportTop: '0px', viewportWidth: '100%', viewportHeight: '100%'
  },
  onInit() {
    var self = this
    this.controller = createDiagnosticsController(function (model) { self.applyModel(model) })
    pageRuntime.bind(this, { contentWidth: function (profile) { return detailDesign.contentWidth(profile) } }, function (profile, scene, safe) {
      var plan = detailDesign.resolve(profile, scene, safe)
      self.headerLeft = plan.header.left; self.headerTop = plan.header.top; self.headerWidth = plan.header.width; self.headerHeight = plan.header.height
      self.streamLeft = plan.stream.left; self.streamTop = plan.stream.top; self.streamWidth = plan.stream.width
      self.pagerHeight = plan.compact ? 16 : 20; self.pagerTop = plan.stream.top + plan.stream.height - self.pagerHeight
      self.streamHeight = Math.max(50, plan.stream.height - self.pagerHeight - 5)
      self.titleSize = plan.titleSize; self.cardRadius = plan.cardRadius
      self.capabilityHeight = plan.compact ? 22 : (plan.tall ? 38 : 28); self.capabilityGap = plan.cardGap
      self.capabilityPageSize = Math.max(2, Math.floor((self.streamHeight - 18) / (self.capabilityHeight + self.capabilityGap)))
      self.controller.configureScene(profile, scene)
    })
  },
  onShow() { if (this.controller) this.controller.refresh() },
  onBackPress() { navigation.back(); return true },
  applyModel(model) {
    var view = diagnosticsView.project(model)
    var device = view.device
    this.deviceFamily = device.deviceFamily; this.screenSize = device.screenSize; this.hostSceneText = device.hostSceneText; this.formFactor = device.formFactor; this.platformText = device.platformText; this.viewportMode = device.viewportMode
    this.capabilities = view.capabilities
    this.refreshPage()
  },
  refreshPage() {
    var state = diagnosticsView.page(this.capabilities, this.pageIndex, this.capabilityPageSize || 3)
    this.pageIndex = state.pageIndex; this.pageText = state.pageText; this.pageProgress = state.pageProgress; this.capabilityPage = state.capabilityPage
  },
  previousPage() { this.pageIndex--; this.refreshPage() },
  nextPage() { this.pageIndex++; this.refreshPage() }
}
</script>

<style>
.detail-root, .detail-scene { background-color: #000000; } .detail-scene { position: absolute; left: 0px; top: 0px; }
.header, .content, .pager { position: absolute; } .header, .info-row, .capability-card, .pager { flex-direction: row; justify-content: space-between; align-items: center; }
.title { color: #64D2FF; font-weight: bold; } .page-text { color: #8E8E93; font-size: 7px; }
.content { flex-direction: column; } .device-card { min-height: 100%; background-color: #111820; padding: 10px; flex-direction: column; }
.device-head { height: 20px; flex-direction: row; align-items: center; } .device-dot { width: 7px; height: 7px; border-radius: 4px; background-color: #64D2FF; margin-right: 6px; } .device-title { color: #FFFFFF; font-size: 10px; font-weight: bold; }
.info-row { width: 100%; min-height: 17px; } .info-label { width: 54px; color: #8E8E93; font-size: 7px; } .info-value { flex: 1; color: #FFFFFF; font-size: 7px; text-align: right; lines: 1; text-overflow: ellipsis; } .accent { color: #64D2FF; }
.device-tip, .capability-tip { width: 100%; color: #6E7681; font-size: 6px; line-height: 9px; margin-top: 5px; }
.capability-list { width: 100%; height: 100%; flex-direction: column; } .capability-card { background-color: #11151B; padding-left: 9px; padding-right: 8px; }
.capability-copy { flex: 1; flex-direction: column; } .capability-name { color: #FFFFFF; font-size: 8px; font-weight: bold; } .capability-api { color: #777D87; font-size: 5px; margin-top: 1px; lines: 1; text-overflow: ellipsis; }
.status-pill { width: 38px; height: 16px; border-radius: 8px; justify-content: center; align-items: center; } .status-text { width: 36px; font-size: 6px; text-align: center; }
.pager-button { width: 30px; color: #64D2FF; font-size: 18px; text-align: center; } .pager-track { width: 72px; height: 4px; border-radius: 2px; background-color: #24262B; } .pager-fill { height: 4px; border-radius: 2px; background-color: #64D2FF; }
</style>
