<template>
  <stack class="demo-root {{ viewportClass }}" style="position: {{ viewportPosition }}; left: {{ viewportLeft }}; top: {{ viewportTop }}; width: {{ viewportWidth }}; height: {{ viewportHeight }};">
    <div class="demo-scene" style="width: {{ sceneWidth }}px; height: {{ sceneHeight }}px;">
      <text class="demo-title" style="left: {{ titleLeft }}px; top: {{ titleTop }}px; width: {{ titleWidth }}px; height: {{ titleHeight }}px; font-size: {{ titleSize }}px;">通知演示</text>
      <div class="button-stack" style="left: {{ buttonsLeft }}px; top: {{ buttonsTop }}px; width: {{ buttonsWidth }}px; height: {{ buttonsHeight }}px;">
        <text class="demo-button" @click="demoSms" style="width: {{ buttonsWidth }}px; height: {{ buttonHeight }}px; margin-bottom: {{ buttonGap }}px; border-radius: {{ buttonRadius }}px; font-size: {{ buttonSize }}px;">短信演示</text>
        <text class="demo-button" @click="demoCall" style="width: {{ buttonsWidth }}px; height: {{ buttonHeight }}px; margin-bottom: {{ buttonGap }}px; border-radius: {{ buttonRadius }}px; font-size: {{ buttonSize }}px;">电话演示</text>
        <text class="demo-button" @click="demoApp" style="width: {{ buttonsWidth }}px; height: {{ buttonHeight }}px; margin-bottom: {{ buttonGap }}px; border-radius: {{ buttonRadius }}px; font-size: {{ buttonSize }}px;">应用演示</text>
        <text class="demo-button back-button" @click="goBack" style="width: {{ buttonsWidth }}px; height: {{ buttonHeight }}px; border-radius: {{ buttonRadius }}px; font-size: {{ buttonSize }}px;">返回</text>
      </div>

      <div class="notification-cover" if="{{ notifyVisible }}">
        <div class="notification-body" if="{{ notifyType !== 'call' }}"><div class="notification-app"><image class="notification-icon" src="{{ notifyAppIcon }}"></image><text class="notification-name">{{ notifyAppName }}</text></div><text class="notification-content">{{ notifyContent }}</text></div>
        <div class="notification-body" if="{{ notifyType === 'call' }}"><text class="call-contact">{{ notifyContact }}</text><text class="call-phone">{{ notifyPhone }}</text></div>
        <div class="notification-actions"><text class="notification-button" @click="handleIgnore">忽略</text><text class="notification-button hangup" if="{{ notifyType === 'call' }}" @click="handleHangup" style="color: {{ notifyHangUpColor }};">挂断</text></div>
      </div>
    </div>
  </stack>
</template>

<script>
import pageRuntime from '../../v2/app/page_runtime'
import navigation from '../../v2/app/navigation'
import { createNotificationController } from '../../v2/features/notification/controller'
import notificationDesign from '../../v2/design/specs/notification_demo'
import notificationView from '../../v2/design/views/notification'

export default {
  private: {
    notifyVisible: false, notifyType: '', notifyAppName: '', notifyAppIcon: '/common/logo.png', notifyContent: '', notifyContact: '', notifyPhone: '', notifyHangUp: false, notifyHangUpColor: '#FFFFFF',
    titleLeft: 22, titleTop: 24, titleWidth: 148, titleHeight: 22, buttonsLeft: 30, buttonsTop: 52, buttonsWidth: 132, buttonsHeight: 132, buttonHeight: 28, buttonGap: 6, buttonRadius: 14, titleSize: 13, buttonSize: 9,
    sceneWidth: 192, sceneHeight: 192, viewportClass: '', viewportPosition: 'relative', viewportLeft: '0px', viewportTop: '0px', viewportWidth: '100%', viewportHeight: '100%'
  },
  onInit() {
    var self = this
    this.controller = createNotificationController(function (state) { self.applyNotification(state) })
    pageRuntime.bind(this, { contentWidth: 168 }, function (profile, scene, safe) {
      var plan = notificationDesign.resolve(profile, scene, safe)
      self.titleLeft = plan.title.left; self.titleTop = plan.title.top; self.titleWidth = plan.title.width; self.titleHeight = plan.title.height
      self.buttonsLeft = plan.buttons.left; self.buttonsTop = plan.buttons.top; self.buttonsWidth = plan.buttons.width; self.buttonsHeight = plan.buttons.height
      self.buttonHeight = plan.buttonHeight; self.buttonGap = plan.gap; self.buttonRadius = plan.radius; self.titleSize = plan.titleSize; self.buttonSize = plan.buttonSize
    })
  },
  onShow() { if (this.controller) this.controller.start() },
  onHide() { if (this.controller) this.controller.stop() },
  onDestroy() { if (this.controller) this.controller.stop() },
  onBackPress() { navigation.back(); return true },
  applyNotification(state) {
    var view = notificationView.project(state)
    this.notifyVisible = view.visible; this.notifyType = view.type; this.notifyAppName = view.appName; this.notifyAppIcon = view.appIcon; this.notifyContent = view.content; this.notifyContact = view.contact; this.notifyPhone = view.phone; this.notifyHangUp = view.hangUp; this.notifyHangUpColor = view.hangUpColor
  },
  demoSms() { this.controller.showDemo('sms') },
  demoCall() { this.controller.showDemo('call') },
  demoApp() { this.controller.showDemo('app') },
  handleIgnore() { this.controller.dismiss() },
  handleHangup() { this.controller.hangUp() },
  goBack() { navigation.back() }
}
</script>

<style>
.demo-root, .demo-scene { background-color: #000000; }
.demo-scene { position: absolute; left: 0px; top: 0px; overflow: hidden; }
.demo-title, .button-stack { position: absolute; }
.demo-title { color: #FFFFFF; font-weight: bold; text-align: center; }
.button-stack { flex-direction: column; }
.demo-button { background-color: #17191D; color: #FFFFFF; text-align: center; font-weight: bold; }
.back-button { background-color: #2C2C2E; color: #8E8E93; }
.notification-cover { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; background-color: #000000; flex-direction: column; justify-content: center; align-items: center; }
.notification-body { width: 168px; flex: 1; flex-direction: column; justify-content: center; align-items: center; }
.notification-app { flex-direction: row; align-items: center; } .notification-icon { width: 38px; height: 38px; margin-right: 10px; } .notification-name { color: #FFFFFF; font-size: 18px; font-weight: bold; }
.notification-content { width: 160px; color: #D1D1D6; font-size: 14px; line-height: 20px; text-align: center; margin-top: 18px; lines: 3; }
.call-contact { color: #FFFFFF; font-size: 22px; font-weight: bold; } .call-phone { color: #8E8E93; font-size: 15px; margin-top: 10px; }
.notification-actions { width: 168px; height: 56px; margin-bottom: 28px; flex-direction: row; justify-content: center; align-items: center; }
.notification-button { width: 70px; height: 34px; margin-left: 6px; margin-right: 6px; border-radius: 17px; background-color: #1C1C1E; color: #FFFFFF; font-size: 12px; text-align: center; } .hangup { background-color: #C83245; }
</style>
