<template>
  <scroll class="steps-page {{ viewportClass }}" scroll-y="true" style="position: {{ viewportPosition }}; left: {{ viewportLeft }}; top: {{ viewportTop }}; width: {{ viewportWidth }}; height: {{ viewportHeight }}; opacity: {{ pageOpacity }}; margin-left: {{ pageOffset }}px;" @touchstart="onTouchStart" @touchend="onTouchEnd">
    <text class="page-title" static>运动</text>

    <div class="history-entry" @click="goToHistory">
      <text class="history-title" static>7日趋势</text>
      <text class="history-sub" static>查看历史记录</text>
    </div>

    <div for="{{ metrics }}" class="metric-section" tid="name">
      <div class="ml-row">
        <text class="ml-label" style="color: {{ $item.color }}">{{ $item.name }}</text>
      </div>
      <text class="mc-val" style="color: {{ $item.color }}">{{ $item.current }}</text>
      <text class="mg-val" style="color: #888888;">/ {{ $item.goal }} {{ $item.unit }}</text>
      <div class="chart-area">
        <div class="cb-row">
          <div class="bc" for="{{ $item.bars }}" tid="t">
            <div class="bar-space">
              <div class="bar-inner" style="height: {{ $item.h }}px; background-color: {{ $item.color }};"></div>
            </div>
            <text class="bl">{{ $item.t }}</text>
          </div>
        </div>
      </div>
    </div>

  </scroll>
</template>

<script>
import router from '@system.router'
import watchData from '../../common/watch_data'
import pageMotion from '../../common/page_motion'
import pageViewport from '../../common/page_viewport'
import swipeBack from '../../common/swipe_back'

var labels = ['0', '3', '6', '9', '12', '15', '18', '21']
var chartH = 60

function makeBars(vals, color) {
  var bars = []
  var maxVal = vals[0]
  for (var i = 1; i < vals.length; i++) {
    if (vals[i] > maxVal) maxVal = vals[i]
  }
  if (maxVal <= 0) {
    maxVal = 1
  }
  for (var i = 0; i < vals.length; i++) {
    var h = Math.round((vals[i] / maxVal) * chartH)
    if (h < 3) h = 3
    bars.push({ t: labels[i], h: h, color: color })
  }
  return bars
}

var stepBars = makeBars([200, 500, 900, 1200, 1100, 850, 600, 250], '#FFD60A')
var calBars = makeBars([8, 20, 36, 50, 48, 40, 28, 10], '#FF9F0A')
var standBars = makeBars([0.5, 1.0, 1.5, 2.5, 2.0, 1.5, 1.0, 0.5], '#0A84FF')

var metricList = [
  { name: '步数', current: '4,567', goal: '6,000', unit: '步', color: '#FFD60A', bars: stepBars },
  { name: '卡路里', current: '180', goal: '300', unit: 'kcal', color: '#FF9F0A', bars: calBars },
  { name: '站立', current: '8', goal: '12', unit: 'h', color: '#0A84FF', bars: standBars }
]

function formatNumber(value) {
  return value.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',')
}

function makeTrendValues(total) {
  // Small hourly bars are derived from today's total so this page follows the data adapter.
  var ratios = [0.05, 0.11, 0.18, 0.26, 0.22, 0.14, 0.09, 0.04]
  var result = []
  for (var i = 0; i < ratios.length; i++) {
    result.push(Math.max(1, Math.round(total * ratios[i])))
  }
  return result
}

function makeMetrics(snapshot) {
  return [
    {
      name: '步数',
      current: snapshot.stepsText,
      goal: snapshot.stepsGoalText,
      unit: '步',
      color: '#FFD60A',
      bars: makeBars(makeTrendValues(snapshot.steps), '#FFD60A')
    },
    {
      name: '卡路里',
      current: formatNumber(snapshot.calories),
      goal: formatNumber(snapshot.caloriesGoal),
      unit: 'kcal',
      color: '#FF9F0A',
      bars: makeBars(makeTrendValues(snapshot.calories), '#FF9F0A')
    },
    {
      name: '站立',
      current: formatNumber(snapshot.standHours),
      goal: formatNumber(snapshot.standGoal),
      unit: 'h',
      color: '#0A84FF',
      bars: makeBars(makeTrendValues(snapshot.standHours), '#0A84FF')
    }
  ]
}

export default {
  private: {
    metrics: metricList,
    pageOpacity: 1,
    pageOffset: 0,
    viewportClass: '',
    viewportPosition: 'relative',
    viewportLeft: '0px',
    viewportWidth: '100%',
    viewportHeight: '100%',
    viewportTop: '0px'
  },

  onInit() {
    var self = this
    pageViewport.bind(this, function (profile) {
      // 圆屏可视高度更小，柱状图相应压低。屏幕档案是异步解析的，可能晚于
      // onShow，因此拿到形态后必须按新柱高重建一次指标，否则圆屏首帧会沿用
      // 胶囊屏的 60px 柱高而超出安全区。
      chartH = profile.isCircle ? 48 : 60
      self.loadCurrentData()
    })
  },

  onShow() {
    pageMotion.enter(this)
    this.loadCurrentData()
  },

  onHide() {
    pageMotion.clear(this)
    this.releaseMetrics()
  },

  onDestroy() {
    pageMotion.clear(this)
    this.releaseMetrics()
  },

  loadCurrentData() {
    // The sport page reads the same snapshot as watch faces and history storage.
    this.metrics = makeMetrics(watchData.getSnapshot())
  },

  releaseMetrics() {
    // Metrics contain nested bar arrays; rebuild them from the latest snapshot on next show.
    this.metrics = []
  },

  goToHistory() {
    pageMotion.push(this, router, '/pages/history')
  },

  onTouchStart(e) {
    swipeBack.start(this, e)
  },

  onTouchEnd(e) {
    swipeBack.end(this, e, router)
  }
}
</script>

<style>
.steps-page {
  flex-direction: column;
  align-items: center;
  background-color: #000000;
  width: 100%;
  height: 100%;
  padding: 16px;
}

.page-title {
  font-size: 24px;
  font-weight: bold;
  color: #FFD60A;
  text-align: center;
  margin-bottom: 10px;
}

.history-entry {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  width: 160px;
  height: 34px;
  background-color: #14181F;
  border-radius: 8px;
  padding-left: 10px;
  padding-right: 10px;
  margin-bottom: 8px;
}

.history-title {
  font-size: 14px;
  color: #FFFFFF;
  font-weight: bold;
}

.history-sub {
  font-size: 10px;
  color: #8E8E93;
}

.metric-section {
  flex-direction: column;
  width: 160px;
  margin-bottom: 6px;
}

.ml-row {
  flex-direction: row;
  align-items: center;
  margin-bottom: 0px;
}

.ml-label {
  font-size: 12px;
  font-weight: bold;
}

.mc-val {
  font-size: 28px;
  font-weight: bold;
  line-height: 30px;
}

.mg-val {
  font-size: 13px;
  line-height: 16px;
}

.chart-area {
  flex-direction: column;
  margin-top: 0px;
}

.cb-row {
  flex-direction: row;
  align-items: flex-start;
}

.bc {
  flex-direction: column;
  width: 20px;
  align-items: center;
}

.bar-space {
  flex-direction: column;
  width: 20px;
  height: 60px;
  align-items: center;
  justify-content: flex-end;
}

.bar-inner {
  width: 12px;
  border-radius: 2px;
}

.bl {
  width: 20px;
  font-size: 10px;
  color: #666666;
  text-align: center;
  margin-top: 2px;
}

@media (shape: circle) {
  .steps-page {
    padding-top: 18px;
    padding-left: 22px;
    padding-right: 22px;
    padding-bottom: 28px;
  }

  .page-title {
    font-size: 14px;
    margin-bottom: 6px;
  }

  .history-entry,
  .metric-section {
    width: 148px;
  }

  .history-entry {
    height: 29px;
    border-radius: 14px;
  }

  .history-title {
    font-size: 9px;
  }

  .history-sub,
  .ml-label {
    font-size: 7px;
  }

  .mc-val {
    font-size: 21px;
    line-height: 23px;
  }

  .mg-val {
    font-size: 8px;
    line-height: 10px;
  }

  .bc,
  .bar-space,
  .bl {
    width: 18px;
  }

  .bar-space {
    height: 48px;
  }

  .bar-inner {
    width: 10px;
  }

  .bl {
    font-size: 7px;
  }

  .metric-section {
    margin-bottom: 9px;
  }
}
</style>
