<template>
  <div class="dashboard-face">
    <div class="dash-time-block">
      <text class="dash-time">{{ displayHours }}:{{ displayMinutes }}</text>
      <text class="dash-date" style="color: {{ faceAccent }}">{{ displayWeek }}  {{ displayMonth }} {{ displayDate }}</text>
    </div>
    <div class="dash-progress-card" @click="goToSteps">
      <div class="dash-card-row">
        <text class="dash-label">今日步数</text>
        <text class="dash-value" style="color: #FFD60A">{{ stepsText }}</text>
      </div>
      <div class="dash-track">
        <div class="dash-fill" style="width: {{ stepsProgressWidth }}; background-color: #FFD60A;"></div>
      </div>
      <text class="dash-small">目标 {{ stepsGoalText }} 步</text>
    </div>
    <div class="dash-progress-card" @click="goToHeartRate">
      <div class="dash-card-row">
        <text class="dash-label">实时心率</text>
        <text class="dash-value" style="color: #FF375F">{{ currentHeartRate }}</text>
      </div>
      <div class="dash-heart-chart">
        <div class="dash-heart-bar" for="{{ heartRateData }}" style="height: {{ $item.barHeight }}px;"></div>
      </div>
      <text class="dash-small">bpm</text>
    </div>
    <div class="dash-battery-row">
      <image class="dash-battery-icon" src="/common/lightning.png"></image>
      <div class="dash-battery-track">
        <div class="dash-battery-fill" style="width: {{ batteryWidth }}; background-color: {{ batteryColor }};"></div>
      </div>
      <text class="dash-battery-text" style="color: {{ batteryColor }}">{{ batteryPercent }}%</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'

export default {
  // Dashboard face is display-only except for existing detail-page shortcuts.
  props: [
    'displayWeek',
    'displayMonth',
    'displayDate',
    'displayHours',
    'displayMinutes',
    'faceAccent',
    'stepsText',
    'stepsGoalText',
    'stepsProgressWidth',
    'currentHeartRate',
    'heartRateData',
    'batteryPercent',
    'batteryWidth',
    'batteryColor'
  ],

  goToHeartRate() {
    router.push({
      uri: '/pages/heartrate',
      params: {}
    })
  },

  goToSteps() {
    router.push({
      uri: '/pages/steps',
      params: {}
    })
  }
}
</script>

