<template>
  <div class="sport-face">
    <div class="date-display">
      <text class="display-month" style="color: {{ faceAccent }}">{{ displayMonth }}</text>
      <text class="date-separator">/</text>
      <text class="display-date">{{ displayDate }}</text>
    </div>
    <div class="time-container">
      <text class="time-minutes" style="color: {{ faceAccent }}">{{ displayMinutes }}</text>
      <text class="time-hours">{{ displayHours }}</text>
    </div>
    <div class="battery-container">
      <image class="battery-icon" src="/common/lightning.png"></image>
      <div class="battery-bar-bg">
        <div class="battery-bar-fill" style="width: {{ batteryWidth }}; background-color: {{ batteryColor }}"></div>
      </div>
      <text class="battery-text" style="color: {{ batteryColor }}">{{ batteryPercent }}%</text>
    </div>
    <div class="heart-container" @click="goToHeartRate">
      <image class="heart-icon" src="/common/heart.png"></image>
      <div class="heart-chart-wrapper">
        <div class="heart-chart">
          <div class="heart-bar" for="{{ heartRateData }}" style="height: {{ $item.barHeight }}px;"></div>
        </div>
        <text class="heart-rate-text">{{ currentHeartRate }} bpm</text>
      </div>
    </div>
    <div class="step-container" @click="goToSteps">
      <image class="step-icon" src="/common/shoes.png"></image>
      <div class="step-info">
        <text class="step-current">{{ stepsText }}</text>
        <text class="step-goal">/ {{ stepsGoalText }}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'

export default {
  // Props are passed in by clock.ux so the face has no timer of its own.
  props: [
    'displayMonth',
    'displayDate',
    'displayMinutes',
    'displayHours',
    'faceAccent',
    'batteryPercent',
    'batteryWidth',
    'batteryColor',
    'heartRateData',
    'currentHeartRate',
    'stepsText',
    'stepsGoalText'
  ],

  goToHeartRate() {
    router.push({
      uri: '/pages/heartrate',
      params: {}
    })
  },

  goToSteps() {
    router.push({
      uri: '/pages/steps',
      params: {}
    })
  }
}
</script>

