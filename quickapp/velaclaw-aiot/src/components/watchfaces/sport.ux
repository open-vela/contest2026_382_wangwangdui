.date-display { flex-direction: row; align-items: center; }
.display-month { font-size: 22px; font-weight: bold; margin-right: -4px; margin-top: -4px; }
.date-separator { font-size: 30px; color: #FFFFFF; margin: 0 4px; }
.display-date { font-size: 20px; font-weight: bold; color: #FF9F0A; margin-left: -4px; margin-top: 10px; }
.time-container { flex-direction: column; align-items: center; }
.time-minutes { font-size: 72px; font-weight: bold; text-align: center; margin-bottom: -40px; margin-left: 22px; opacity: 0.9; }
.time-hours { font-size: 72px; font-weight: bold; color: #FF9F0A; text-align: center; margin-right: 38px; margin-top: -14px; }
.battery-container { flex-direction: row; align-items: center; margin-top: 12px; }
.battery-icon { width: 18px; height: 18px; margin-right: 6px; }
.battery-bar-bg { width: 108px; height: 6px; background-color: #333333; border-radius: 3px; }
.battery-bar-fill { height: 6px; border-radius: 3px; }
.battery-text { font-size: 12px; margin-left: 6px; }
.heart-container { flex-direction: row; align-items: center; margin-top: 10px; }
.heart-icon { width: 30px; height: 30px; margin-right: 8px; }
.heart-chart-wrapper { flex-direction: column; align-items: center; }
.heart-chart { flex-direction: row; align-items: flex-end; justify-content: space-between; width: 96px; height: 32px; }
.heart-bar { width: 8px; border-radius: 2px; background-color: #FF375F; }
.heart-rate-text { font-size: 12px; color: #FF375F; margin-top: 4px; font-weight: bold; lines: 1; }
.step-container { flex-direction: row; align-items: center; margin-top: 10px; }
.step-icon { width: 34px; height: 34px; }
.step-info { width: 118px; flex-direction: column; margin-left: 10px; }
.step-current { width: 118px; font-size: 15px; color: #FFD60A; font-weight: bold; lines: 1; }
.step-goal { width: 118px; font-size: 12px; color: #8E8E93; lines: 1; }
</style>
