<template>
  <div class="sport-face">
    <div class="date-display">
      <text class="display-month" style="color: {{ faceAccent }}">{{ displayMonth }}</text>
      <text class="date-separator">/</text>
      <text class="display-date">{{ displayDate }}</text>
    </div>
    <div class="time-container">
      <text class="time-minutes" style="color: {{ faceAccent }}">{{ displayMinutes }}</text>
      <text class="time-hours">{{ displayHours }}</text>
    </div>
    <div class="battery-container">
      <image class="battery-icon" src="/common/lightning.png"></image>
      <div class="battery-bar-bg"><div class="battery-bar-fill" style="width: {{ batteryWidth }}; background-color: {{ batteryColor }}"></div></div>
      <text class="battery-text" style="color: {{ batteryColor }}">{{ batteryPercent }}%</text>
    </div>
    <div class="heart-container" @click="openHealth">
      <image class="heart-icon" src="/common/heart.png"></image>
      <div class="heart-chart-wrapper">
        <div class="heart-chart"><div class="heart-bar" for="{{ heartRateData }}" style="height: {{ heartBarHeight($idx) }}px;"></div></div>
        <text class="heart-rate-text">{{ currentHeartRate }} bpm</text>
      </div>
    </div>
    <div class="step-container" @click="openSteps">
      <image class="step-icon" src="/common/shoes.png"></image>
      <div class="step-info"><text class="step-current">{{ stepsText }}</text><text class="step-goal">/ {{ stepsGoalText }}</text></div>
    </div>
  </div>
</template>

<script>
var watchfaceChart = require('../../v2/design/watchface_chart')

export default {
  props: ['displayMonth','displayDate','displayMinutes','displayHours','faceAccent','batteryPercent','batteryWidth','batteryColor','heartRateData','currentHeartRate','stepsText','stepsGoalText'],
  heartBarHeight(index) { return watchfaceChart.sampleBarHeight(this.heartRateData, index, 4, 28, 8) },
  openHealth() { this.$emit('openHealth') },
  openSteps() { this.$emit('openSteps') }
}
</script>

<style>
