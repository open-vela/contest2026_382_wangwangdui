<template>
  <div class="circle-dashboard-face">
    <text class="dashboard-circle-time">{{ displayHours }}:{{ displayMinutes }}</text>
    <text class="dashboard-circle-date" style="color: {{ faceAccent }}">{{ displayWeek }}  {{ displayMonth }} {{ displayDate }}</text>
    <div class="dashboard-circle-grid">
      <div class="dashboard-circle-card" @click="goToSteps">
        <text class="dashboard-circle-label">步数</text>
        <text class="dashboard-circle-value step-color">{{ stepsText }}</text>
        <div class="dashboard-circle-track">
          <div class="dashboard-circle-fill" style="width: {{ stepsProgressWidth }}; background-color: #FFD60A;"></div>
        </div>
      </div>
      <div class="dashboard-circle-card" @click="goToHeartRate">
        <text class="dashboard-circle-label">心率</text>
        <text class="dashboard-circle-value heart-color">{{ currentHeartRate }}</text>
        <div class="dashboard-circle-bars">
          <div class="dashboard-circle-bar" for="{{ heartRateData }}" style="height: {{ $item.circleBarHeight }}px;"></div>
        </div>
      </div>
    </div>
    <div class="dashboard-circle-battery">
      <image class="dashboard-circle-icon" src="/common/lightning.png"></image>
      <div class="dashboard-circle-battery-track">
        <div class="dashboard-circle-battery-fill" style="width: {{ batteryWidth }}; background-color: {{ batteryColor }};"></div>
      </div>
      <text class="dashboard-circle-battery-text" style="color: {{ batteryColor }}">{{ batteryPercent }}%</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'

export default {
  props: [
    'displayWeek',
    'displayMonth',
    'displayDate',
    'displayHours',
    'displayMinutes',
    'faceAccent',
    'stepsText',
    'stepsProgressWidth',
    'currentHeartRate',
    'heartRateData',
    'batteryPercent',
    'batteryWidth',
    'batteryColor'
  ],

  goToHeartRate() {
    router.push({ uri: '/pages/heartrate', params: {} })
  },

  goToSteps() {
    router.push({ uri: '/pages/steps', params: {} })
  }
}
</script>

