<template>
  <div class="simple-face">
    <div class="simple-heading">
      <text class="simple-week" style="color: {{ faceAccent }}">{{ displayWeek }}</text>
      <text class="simple-date">{{ displayMonth }} {{ displayDate }}</text>
    </div>
    <stack class="simple-neon-dial">
      <progress class="simple-neon-arc" type="arc" percent="{{ goalPercent }}" style="color: {{ faceAccent }};"></progress>
      <div class="simple-dial-center">
        <text class="simple-time">{{ displayHours }}:{{ displayMinutes }}</text>
        <text class="simple-goal" style="color: {{ faceAccent }}">目标 {{ goalPercent }}%</text>
      </div>
    </stack>
    <div class="simple-metrics">
      <div class="simple-metric" @click="goToSteps">
        <text class="simple-metric-value" style="color: #FFD60A">{{ stepsText }}</text>
        <text class="simple-metric-label">步数</text>
      </div>
      <div class="simple-metric" @click="goToHeartRate">
        <text class="simple-metric-value" style="color: #FF375F">{{ currentHeartRate }}</text>
        <text class="simple-metric-label">心率</text>
      </div>
      <div class="simple-metric">
        <text class="simple-metric-value" style="color: {{ batteryColor }}">{{ batteryPercent }}%</text>
        <text class="simple-metric-label">电量</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'

export default {
  // The clock page owns data refresh; this component only renders one face.
  props: [
    'displayWeek',
    'displayMonth',
    'displayDate',
    'displayHours',
    'displayMinutes',
    'faceAccent',
    'goalPercent',
    'stepsText',
    'currentHeartRate',
    'batteryPercent',
    'batteryColor'
  ],

  goToHeartRate() {
    router.push({
      uri: '/pages/heartrate',
      params: {}
    })
  },

  goToSteps() {
    router.push({
      uri: '/pages/steps',
      params: {}
    })
  }
}
</script>

